<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>WinPodiums.Plugin</RootNamespace>
    <AssemblyName>WinPodiums.Plugin</AssemblyName>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <!-- Add SimHub SDK reference (canonical path: C:\Program Files (x86)\SimHub), e.g.:
  <ItemGroup>
    <Reference Include="SimHubPlugin">
      <HintPath>C:\Program Files (x86)\SimHub\Plugins\SimHubPlugin.dll</HintPath>
    </Reference>
  </ItemGroup>
  See README.md and docs/design/components/simhub-plugin.md -->
</Project>
